# quant_workflow local environment template.
#
# Copy to `.env` only if you want shell sessions to load these values manually.
# Do not put real credentials in this example file.

# Shared project roots.
# WORKING_PROJECTS_ROOT is only the default root for optional external
# reference projects. Move this embedded workflow with QUANT_WORKFLOW_ROOT.
DSA_ROOT=/path/to/daily_stock_analysis
WORKING_PROJECTS_ROOT=/path/to/working-projects
QUANT_WORKFLOW_ROOT=/path/to/daily_stock_analysis/quant_workflow
QUANT_WORKFLOW_REPORTS_ROOT=/path/to/daily_stock_analysis/quant_workflow/reports
QUANT_DATA_ROOT=/path/to/daily_stock_analysis/quant_data

# Optional provider overrides.
QLIB_PROVIDER_URI=/path/to/daily_stock_analysis/quant_data/qlib/cn_data_baostock_jqdata
QLIB_CLEANED_PROVIDER_URI=/path/to/daily_stock_analysis/quant_data/qlib/cn_data_baostock_jqdata_cleaned

# Shared runtime.
QUANT_WORKFLOW_PYTHON=/path/to/daily_stock_analysis/.venv/bin/python
CHINA_ASTOCK_PYTHON=/path/to/daily_stock_analysis/.venv/bin/python

# Optional china-astock-quant reference project.
CHINA_ASTOCK_QUANT_ROOT=/path/to/working-projects/china-astock-quant

# Optional JQData credentials for real local downloads.
# Browser-triggered JQData jobs default to dry-run and must not print secrets.
JQ_USERNAME=your_joinquant_phone_or_email
JQ_PASSWORD=your_joinquant_password
