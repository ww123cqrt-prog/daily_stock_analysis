# quant_workflow local environment template.
#
# Copy to `.env` only if you want shell sessions to load these values manually.
# Do not put real credentials in this example file.

# Shared project roots.
# WORKING_PROJECTS_ROOT is only the default root for optional external
# reference projects. Move this embedded workflow with QUANT_WORKFLOW_ROOT.
DSA_ROOT=/path/to/daily_stock_analysis
WORKING_PROJECTS_ROOT=/path/to/working-projects
QUANT_WORKFLOW_ROOT=/path/to/daily_stock_analysis/quant_workflow
QUANT_WORKFLOW_REPORTS_ROOT=/path/to/daily_stock_analysis/quant_workflow/reports
QUANT_WORKFLOW_MLRUNS_DIR=/path/to/daily_stock_analysis/quant_workflow/mlruns
# Data can live either in the repo-local quant_data or next to the DSA repo.
QUANT_DATA_ROOT=/path/to/quant_data

# Canonical and cleaned Qlib normally resolve their native immutable snapshots
# through DATA_MANIFEST.json.
# These may only pin fully validated native snapshots; compatibility paths fail closed.
# QLIB_PROVIDER_URI=/path/to/quant_data/qlib/cn_data_ashare_v2/snapshots/<snapshot_id>
# QLIB_CLEANED_PROVIDER_URI=/path/to/quant_data/qlib/cn_data_ashare_cleaned_v2/snapshots/<snapshot_id>
# Mutable compatibility maintenance tools only; canonical DSA consumers ignore it.
# QLIB_COMPATIBILITY_PROVIDER_URI=/path/to/quant_data/qlib/cn_data_baostock_jqdata
# QLIB_CLEANED_COMPATIBILITY_PROVIDER_URI=/path/to/quant_data/qlib/cn_data_baostock_jqdata_cleaned

# Shared runtime.
QUANT_WORKFLOW_PYTHON=/path/to/daily_stock_analysis/.venv/bin/python
CHINA_ASTOCK_PYTHON=/path/to/daily_stock_analysis/.venv/bin/python

# Optional china-astock-quant reference project.
CHINA_ASTOCK_QUANT_ROOT=/path/to/working-projects/china-astock-quant

# Optional JQData credentials for real local downloads.
# Prefer ~/.agents/private/quant-workbench/jqdata.env for real secrets.
# Browser-triggered JQData jobs default to dry-run and must not print secrets.
JQDATA_ENV_FILE=/path/to/private/jqdata.env
